# =======================================================
# WorkNest - Unified Business Management Platform
# Environment Configuration Template
# (Strictly no Stripe, Twilio, or Telegram)
# =======================================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_long
SESSION_EXPIRY=7d

# Database
DATABASE_URL="file:./dev.db"

# Demonstration Settings
DEMO_MODE=true
DEFAULT_DEMO_TIMER_SECONDS=30

# Integration A: Meta WhatsApp Cloud API (Pakistan & Global)
# Leave blank for "Not Connected" safe state
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Integration B: Safepay Sandbox (Pakistan Payment Gateway)
# https://sandbox.api.getsafepay.com
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_SANDBOX_URL=https://sandbox.api.getsafepay.com

# Integration C: Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-calendar/callback

# Integration D: SMTP Email Notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WorkNest Notifications <alerts@worknest.app>"
